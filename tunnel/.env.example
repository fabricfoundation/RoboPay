# ── Fabric tunnel: base config ────────────────────────────────────────────
# WebSocket URL of the Fabric proxy the tunnel dials out to.
PROXY_WS_URL=wss://api.fabric.foundation/api/core/ws/robot
# x402 micropayment facilitator.
FACILITATOR_URL=https://x402.org/facilitator
# gin log verbosity: "release" or "debug".
GIN_MODE=debug

# Chain preset: bsc-testnet | bsc-mainnet | base-sepolia | base-mainnet.
# Sets both the x402 payment network and the AIP registration chain. When
# unset, payments use config.json "network" (default Base mainnet) and AIP
# registration uses BSC testnet. Make sure FACILITATOR_URL supports the
# selected network.
CHAIN=base-sepolia

# ── MPP: Machine Payments Protocol (Tempo stablecoin) ─────────────────────
# Offered alongside x402 on POST /action; the payer picks by which header it
# sends. Settles in a Tempo stablecoin — the only method the Go SDK ships.
MPP_ENABLED=true

# REQUIRED when MPP_ENABLED=true. HMAC-binds the challenge IDs the tunnel
# issues, so a short or shared secret makes them forgeable. Must be >= 32
# bytes. Generate your own:
#     openssl rand -base64 32
MPP_SECRET_KEY=replace-me-with-openssl-rand-base64-32

# Tempo chain, CAIP-2. eip155:42431 = Moderato testnet, eip155:4217 = mainnet.
MPP_NETWORK=eip155:42431

# Tempo address that receives MPP payments. Defaults to evm_payee_address in
# config.json. Tempo addresses are EVM-shaped, so one wallet can serve both.
# MPP_PAYEE_ADDRESS=0xYourTempoAddress

# Token the price is charged in. Pin it explicitly: left blank, the Go SDK
# advertises AlphaUSD on testnet while the Python/TS SDKs default to pathUSD,
# and the payer needs a balance of whichever the tunnel advertises. The
# Moderato faucet mints both. pathUSD is the newer SDK default:
#   pathUSD  0x20c0000000000000000000000000000000000000
#   AlphaUSD 0x20c0000000000000000000000000000000000001
# pathUSD is the verified-working choice against Moderato.
MPP_CURRENCY=0x20c0000000000000000000000000000000000000

# Token decimals used to convert `price` into atomic units.
# MPP_DECIMALS=6

# Authentication realm advertised in the challenge (default: robot_id).
# MPP_REALM=test-robot

# Tempo JSON-RPC endpoint. Only needed for a chain other than mainnet or
# Moderato — both of those resolve automatically.
# MPP_RPC_URL=https://rpc.moderato.tempo.xyz

# ── BitAgent / Unibase AIP registration ───────────────────────────────────
# Master switch. When true the robot registers itself as an A2A agent on the
# AIP (BitAgent) network via the gateway. Requires the vars below.
AIP_ENABLED=true

# Bearer token for registration — the platform resolves your account from
# it. OPTIONAL: when unset, the tunnel opens an interactive browser
# authorization on first run and caches the token in
# ~/.config/unibase-aip-sdk/config.json. UNIBASE_PROXY_AUTH takes priority,
# PRIVY_TOKEN is the fallback.
# UNIBASE_PROXY_AUTH=your-bearer-token
# PRIVY_TOKEN=your-bearer-token

# Wallet address to register under. Only needed for token-less registration;
# normally derived from the bearer token.
# AIP_USER_ID=0xYourWalletAddress

# Optional overrides (defaults shown).
# AIP_ENDPOINT=https://api.aip.unibase.com
# GATEWAY_URL=https://gateway.aip.unibase.com
# AIP_PUBLIC_BASE_URL=https://api.fabric.foundation/api/core
# AIP_AGENT_NAME=Robot my-robot
# AIP_LOCAL_PORT=8000
