*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
# Preserve the pinned vendor files byte-for-byte so their published hashes are
# stable on Windows and Linux. Profile-owned XML is generated at runtime.
vendor/**/*.urdf binary
vendor/**/*.xml binary
vendor/**/*.yaml binary
*.STL binary
*.onnx binary
