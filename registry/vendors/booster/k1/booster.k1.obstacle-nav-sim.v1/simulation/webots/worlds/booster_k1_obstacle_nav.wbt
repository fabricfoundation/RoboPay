#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "../protos/K1BaseProxy.proto"

WorldInfo {
  basicTimeStep 10
}
Viewpoint {
  orientation -0.3 0.3 0.9 1.6
  position 2 -8 6
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 10 10
}

DEF K1BASE K1BaseProxy {
  translation 0 0 0.4
  name "k1_base"
}

DEF OBSTACLE_1 Solid {
  translation 2.5 0 0.3
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.9 0.2 0.2 }
      geometry Cylinder { height 0.6 radius 0.4 }
    }
  ]
  name "obstacle_1"
  boundingObject Cylinder { height 0.6 radius 0.4 }
}

DEF OBSTACLE_2 Solid {
  translation 1.2 1.0 0.3
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.9 0.6 0.1 }
      geometry Box { size 0.6 0.6 0.6 }
    }
  ]
  name "obstacle_2"
  boundingObject Box { size 0.6 0.6 0.6 }
}

Solid {
  translation 5 0 0.05
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.1 0.9 0.1 transparency 0.5 }
      geometry Cylinder { height 0.04 radius 0.3 }
    }
  ]
  name "goal_marker"
}
