<mujoco model="agibot_x2_primitives">
  <!-- AgiBot X2 kinematic chain with collision-primitive geometry.
       Vendor mesh assets unavailable at submission time; see docs/README.md. -->
  <compiler angle="radian" eulerseq="XYZ" autolimits="true"/>
  <option timestep="0.01" gravity="0 0 -9.81"/>

  <default>
    <default class="x2">
      <joint damping="0.5" armature="0.02" frictionloss="0.1"/>
      <default class="collision">
        <geom type="capsule" rgba="0.7 0.7 0.75 1" contype="1" conaffinity="1"/>
