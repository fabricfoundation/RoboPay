<mujoco model="agibot_x2_headless">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <default>
    <joint damping="2" armature="0.02"/>
    <geom type="capsule" density="700" friction="1 0.1 0.1" rgba="0.22 0.48 0.78 1"/>
    <position kp="80" kv="8" ctrllimited="true" ctrlrange="-1 1"/>
  </default>
  <worldbody>
    <light pos="0 -2 3" dir="0 1 -1"/>
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.18 0.18 0.18 1"/>
    <body name="pelvis" pos="0 0 0.72">
      <!-- A constrained root slide gives deterministic locomotion evidence in
           headless CI while retaining the X2 body/joint dimensions. -->
      <joint name="root_x" type="slide" axis="1 0 0" range="-2 2" damping="8"/>
      <geom name="pelvis_geom" type="box" size="0.11 0.12 0.07"/>
      <body name="torso" pos="0 0 0.22">
        <geom type="box" size="0.12 0.15 0.20"/>
        <body name="left_arm" pos="0 0.19 0.14">
          <joint name="left_shoulder_pitch" axis="0 1 0" range="-1.5 1.5"/>
          <geom fromto="0 0 0 0 0 -0.26" size="0.035"/>
        </body>
        <body name="right_arm" pos="0 -0.19 0.14">
          <joint name="right_shoulder_pitch" axis="0 1 0" range="-1.5 1.5"/>
          <geom fromto="0 0 0 0 0 -0.26" size="0.035"/>
        </body>
        <body name="head" pos="0 0 0.31">
          <geom type="sphere" size="0.095"/>
        </body>
      </body>
      <body name="left_leg" pos="0 0.075 -0.07">
        <joint name="left_hip_pitch" axis="0 1 0" range="-0.8 0.8"/>
        <geom fromto="0 0 0 0 0 -0.30" size="0.045"/>
        <body pos="0 0 -0.30">
          <joint name="left_knee" axis="0 1 0" range="0 1.4"/>
          <geom fromto="0 0 0 0 0 -0.30" size="0.04"/>
        </body>
      </body>
      <body name="right_leg" pos="0 -0.075 -0.07">
        <joint name="right_hip_pitch" axis="0 1 0" range="-0.8 0.8"/>
        <geom fromto="0 0 0 0 0 -0.30" size="0.045"/>
        <body pos="0 0 -0.30">
          <joint name="right_knee" axis="0 1 0" range="0 1.4"/>
          <geom fromto="0 0 0 0 0 -0.30" size="0.04"/>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="forward_policy" joint="root_x" ctrlrange="-2 2" kp="30" kv="6"/>
    <position name="left_shoulder_policy" joint="left_shoulder_pitch"/>
    <position name="right_shoulder_policy" joint="right_shoulder_pitch"/>
    <position name="left_hip_policy" joint="left_hip_pitch"/>
    <position name="right_hip_policy" joint="right_hip_pitch"/>
    <position name="left_knee_policy" joint="left_knee" ctrlrange="0 1"/>
    <position name="right_knee_policy" joint="right_knee" ctrlrange="0 1"/>
  </actuator>
</mujoco>
