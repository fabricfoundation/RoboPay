<!--
  Push-to-target scene for the AgiBot X2 (Ultra variant).

  The robot itself comes from AgibotTech/agibot_x2_urdf unchanged; this file
  only adds the world the task needs: a work surface, a free puck, and a
  visual marker for the commanded destination.

  Both the puck's start position and the destination come from the paid
  action's parameters and are substituted at load time. That is what stops the
  task from being reducible to a replayed trajectory: the payer picks both
  ends of the motion, so a canned animation has nothing to replay.

  Table height and the workspace bounds are measured rather than chosen, and
  they are measured for the frame the IK actually constrains. With the base
  welded at the origin the left wrist solves across x in [0.20, 0.50],
  y in [0.05, 0.35] at wrist height; the skill's published parameter ranges
  are that measurement.

  Placeholders: {{PUCK_X}} {{PUCK_Y}} {{PUCK_Z}} {{GOAL_X}} {{GOAL_Y}}
                {{SURFACE_HALF}} {{MARKER_Z}} {{TABLE_HALF}}
                {{PUCK_R}} {{PUCK_HZ}} {{PUCK_MASS}} {{PUCK_FRICTION}}
-->
<mujoco model="x2_push_to_target">
  <include file="x2_fixed_base.xml"/>

  <statistic center="0.32 0.20 0.10" extent="1.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <!-- Offscreen buffer must cover any frame we render; the demo recording
         is captured at 960x720. -->
    <global azimuth="150" elevation="-20" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="tskygrid" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="tground" texture="tskygrid" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.42 0.40 0.38 1"/>
    <material name="puck_mat" rgba="0.85 0.35 0.15 1"/>
    <material name="goal_mat" rgba="0.15 0.75 0.35 1"/>
  </asset>

  <worldbody>
    <light pos="0.3 0.2 2.5" dir="0 0 -1" directional="true"/>
    <geom name="task_floor" size="0 0 0.05" type="plane" material="tground"
          pos="0 0 -1.0"/>

    <!-- Work surface, centred on the reachable band. -->
    <body name="table" pos="0.34 0.20 {{SURFACE_HALF_POS}}">
      <geom name="table_geom" type="box"
            size="{{TABLE_HALF}} {{TABLE_HALF}} {{SURFACE_HALF}}"
            material="table_mat" friction="0.6 0.02 0.001"/>
    </body>

    <!-- Commanded destination. Visual only: it must not perturb the physics,
         so it carries no collision geometry. -->
    <body name="goal" pos="{{GOAL_X}} {{GOAL_Y}} {{MARKER_Z}}">
      <geom name="goal_geom" type="cylinder" size="0.035 0.0015"
            material="goal_mat" contype="0" conaffinity="0" mass="0"/>
    </body>

    <!-- The puck the policy must move. A cylinder, so the outcome does not
         depend on which roll the IK solver happened to pick for the wrist. -->
    <body name="puck" pos="{{PUCK_X}} {{PUCK_Y}} {{PUCK_Z}}">
      <freejoint name="puck_free"/>
      <geom name="puck_geom" type="cylinder" size="{{PUCK_R}} {{PUCK_HZ}}"
            material="puck_mat" mass="{{PUCK_MASS}}"
            friction="{{PUCK_FRICTION}} 0.02 0.001"
            solimp="0.95 0.99 0.001" solref="0.006 1"/>
    </body>
  </worldbody>
</mujoco>
